# Base URL of the Nexo REST API
VITE_API_URL="http://localhost:3000"

# URL of the Socket.io real-time server (usually the API origin)
VITE_SOCKET_URL="http://localhost:3000"

# URL of the Cloudflare upload worker that issues presigned R2 URLs
VITE_UPLOAD_URL="https://your-upload-worker.workers.dev"
