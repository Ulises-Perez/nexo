# Base URL of the Nexo REST API
VITE_API_URL="http://localhost:3000"

# URL of the Socket.io real-time server (usually the API origin)
VITE_SOCKET_URL="http://localhost:3000"

# TURN/TURNS server(s) for voice and screen share WebRTC connections, as a
# comma-separated list of urls (e.g. "turn:turn.example.com:3478,turns:turn.example.com:5349").
# Empty = STUN-only (current default) — works for most peers but not those
# behind symmetric NAT or restrictive firewalls.
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
