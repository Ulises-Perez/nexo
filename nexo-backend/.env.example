# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexo?schema=public"

# Secret used to sign and verify JWT access tokens.
# Use a long, random string. NEVER commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API server listens on
PORT=3000

# Comma-separated list of allowed client origins (CORS)
CORS_ORIGINS="http://localhost:1420,http://localhost:5173"

# development | production
NODE_ENV=development
