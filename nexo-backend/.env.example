# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexo?schema=public"

# Secret used to sign and verify JWT access tokens.
# Use a long, random string. NEVER commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API server listens on
PORT=3000

# Comma-separated list of allowed client origins (CORS).
# Shared by the HTTP API and Socket.io. Include the Tauri webview origin
# (http://tauri.localhost) for production desktop builds.
CORS_ORIGINS="http://localhost:1420,http://localhost:5173,http://tauri.localhost"

# development | production
NODE_ENV=development

# GitHub personal access token with read access to the private repo's
# Releases API (contents: read). Used by the Tauri auto-updater proxy
# to fetch release metadata and download private release assets.
GITHUB_RELEASES_TOKEN=

# Public URL of the Cloudflare upload worker (no trailing slash).
# The backend proxies presign requests to it; clients never call it directly.
UPLOAD_WORKER_URL="https://your-upload-worker.workers.dev"

# Shared secret sent as `Authorization: Bearer` on presign requests.
# Must match the worker's UPLOAD_SECRET (`wrangler secret put UPLOAD_SECRET`).
UPLOAD_WORKER_SECRET="replace-with-a-long-random-secret"

# Public CDN base URL attachments must point at (the worker's CDN_URL).
# Fail closed: when empty, every message attachment is rejected.
ATTACHMENT_CDN_URL="https://pub-xxxxxxxx.r2.dev"

# Optional. When set, Socket.io uses the Redis adapter so rooms/emits work
# across replicas. NOTE: voice roster and presence counters are still
# in-process; keep a single replica until they are moved to Redis.
REDIS_URL=
